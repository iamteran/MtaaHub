# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mtaahub?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: Supabase (if using Supabase for DB + Auth + Storage)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: Email (for notifications)
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="user"
# EMAIL_SERVER_PASSWORD="password"
# EMAIL_FROM="noreply@mtaahub.co.ke"

# Optional: File Storage (Supabase Storage or AWS S3)
# STORAGE_PROVIDER="supabase"
# STORAGE_BUCKET="mtaahub-uploads"

# Feature Flags
NEXT_PUBLIC_ENABLE_AI="false"
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="false"
